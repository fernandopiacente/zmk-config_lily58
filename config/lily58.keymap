#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        // Combo: M (45) + Vírgula (46) = Interrogação (?)
        combo_question {
            timeout-ms = <50>;
            key-positions = <45 46>;
            bindings = <&kp QMARK>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |   `      |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
            // |  TAB     |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   =   |
            // |hCTRL tESC|  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT    |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                        | ALT  | GUI  | LOWER|  SPACE |  | BSPC  | ENTER| RAISE | RCTRL |

            bindings = <
&kp GRAVE      &kp N1  &kp N2  &kp N3    &kp N4     &kp N5                         &kp N6   &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB        &kp Q   &kp W   &kp E     &kp R      &kp T                          &kp Y    &kp U   &kp I      &kp O    &kp P     &kp EQUAL
&mt LCTRL ESC  &kp A   &kp S   &kp D     &kp F      &kp G                          &kp H    &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT      &kp Z   &kp X   &kp C     &kp V      &kp B   &kp LBKT     &kp RBKT  &kp N    &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                               &kp LALT  &kp LMETA  &mo 2   &kp SPACE    &kp BSPC  &kp RET  &mo 1   &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // POLEGAR DIREITO (RAISE - mo 1):
            // Fileira Superior: F1..F12 (F11 na tecla do -)
            // Mão Esquerda: Controles de Mídia, Volume e Insert (Q, A..F, Z..X)
            // Mão Direita: Setas, Navegação (HJKL, HOME, END, PG_UP, PG_DN, DEL)
            bindings = <
&kp F12        &kp F1      &kp F2        &kp F3        &kp F4      &kp F5                    &kp F6     &kp F7     &kp F8     &kp F9     &kp F10   &kp F11
&kp GRAVE      &kp INS     &trans        &trans        &trans      &trans                    &trans     &trans     &trans     &trans     &trans    &kp MINUS
&mt LCTRL ESC  &kp C_PP    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &trans                    &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp HOME  &kp END
&kp LSHIFT     &kp C_PREV  &kp C_NEXT    &trans        &trans      &trans  &trans    &kp DEL &kp PG_DN  &kp PG_UP  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH
                                             &trans        &trans      &trans  &trans    &trans  &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // POLEGAR ESQUERDO (LOWER - mo 2):
            // Mão Esquerda: Símbolos + Seleção de Perfil BT (1 a 5)
            // Mão Direita: Numpad (UIO = 789 | JKL = 456 | M,. = 123 | Enter = 0)
            bindings = <
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                     &trans      &trans         &kp KP_SLASH     &kp KP_MULTIPLY &kp KP_MINUS &kp KP_PLUS
&trans          &kp EXCL      &kp AT        &kp HASH      &kp DOLLAR    &kp PRCNT                        &trans      &kp N7         &kp N8           &kp N9          &kp SEMI     &kp SQT
&kp TILDE       &kp CARET     &kp AMPS      &kp LPAR      &kp RPAR      &kp UNDER                        &trans      &kp N4         &kp N5           &kp N6          &kp COLON    &kp BSLH
&kp LSHIFT      &trans        &trans        &kp LBRC      &kp RBRC      &trans        &trans    &kp DEL  &trans      &kp N1         &kp N2           &kp N3          &kp QMARK    &kp RSHFT
                                            &trans        &trans        &trans        &trans    &trans   &kp N0      &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            // CAMADA ISOLADA NA MÃO ESQUERDA (LOWER + RAISE)
            // NENHUMA tecla de Bluetooth existe na mão direita!
            bindings = <
&bt BT_CLR      &bt BT_CLR_ALL &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans         &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans         &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans         &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
